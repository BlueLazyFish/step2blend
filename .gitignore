# ── Build artifacts ──────────────────────────────────────────────────────────
# CMake build trees, OCCT bundle output, compiled binaries + dylibs/DLLs.
# Everything in here is regenerated by scripts/ship-mac.sh (or the future
# Windows equivalent) — keep them out of source control.
step2glb/build/
step2glb/bundle/
step_importer/bin/
step_importer/lib/

# Built distributables. Releases live in GitHub Releases or Gumroad, not git.
*.zip

# ── macOS / IDE noise ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*~

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ── CMake / C++ ──────────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
*.o
*.a

# ── Test fixtures we don't want in the repo ──────────────────────────────────
# The repo ships generic test.stp / test2.stp under step2glb/. Anything else
# named .step / .STEP / .stp / .STP at the repo root is assumed to be
# customer geometry and stays out.
/*.step
/*.STEP
/*.stp
/*.STP

# Local dev scratch
scratch/
*.log
